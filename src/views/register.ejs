<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <div class="container">
    <div class="card form-card">
      <h2>Create Account</h2>
      <div id="message" class="message hidden"></div>
      <form id="register-form">
        <div class="form-group">
          <label for="name">Name</label>
          <input type="text" id="name" required minlength="2" />
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" required />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" required minlength="8" />
        </div>
        <div class="form-group">
          <label for="role">I am a…</label>
          <select id="role" required>
            <option value="eventee">Eventee (attending events)</option>
            <option value="creator">Creator (hosting events)</option>
          </select>
        </div>
        <button type="submit" class="btn btn-full">Create Account</button>
      </form>
      <p style="text-align: center; margin-top: 16px;">
        Already have an account? <a href="/login">Log in</a>
      </p>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/register.js"></script>
</body>
</html>
